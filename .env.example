# ---------------------------------------------------------------------------
# CoachOS environment
#
# Copy to .env.local and fill in with values from your own Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every table is
# protected by row-level security, so this key alone grants access to nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of this deployment, e.g. https://coachos.vercel.app
# Used to build the links Supabase emails out (signup confirmation, password
# reset). Set it in production — without it CoachOS guesses from the request
# headers, which is right for previews but not for emailed links.
NEXT_PUBLIC_SITE_URL=

# --- Optional ---------------------------------------------------------------

# Allow search engines to index the marketing surface. Application routes stay
# disallowed either way. Leave unset for a private beta.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Escape hatch: run a PRODUCTION build against the in-memory demo store.
# Without Supabase credentials a production runtime refuses to start, because
# demo mode serves the same seeded data to every visitor with no authentication.
# Set this ONLY for a deliberately public demo build.
# COACHOS_ALLOW_DEMO_MODE=true

# NOTE: the service_role key is deliberately NOT used by this application.
# It bypasses row-level security. Do not add it here or to Vercel.

# --- Integration tests only (put these in .env.test.local) ------------------
# See tests/integration/README.md. Point these at a SEPARATE test project.
# COACHOS_TEST_COACH_A_EMAIL=
# COACHOS_TEST_COACH_A_PASSWORD=
# COACHOS_TEST_COACH_B_EMAIL=
# COACHOS_TEST_COACH_B_PASSWORD=
