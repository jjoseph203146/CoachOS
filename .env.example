# ---------------------------------------------------------------------------
# CoachOS environment
#
# Copy to .env.local and fill in with values from your own Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real keys.
#
# If BOTH variables below are absent, CoachOS runs against an in-memory
# development store seeded with demo data, so the app still starts on a fresh
# clone. That store is not persistent and is not for production.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every table is
# protected by row-level security, so this key alone grants access to nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: the service_role key is deliberately NOT used by this application.
# It bypasses row-level security. Do not add it here or to Vercel.
